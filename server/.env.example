# =================================================================
# NARSS Dashboard Backend Configuration
# =================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/narss_dashboard
# Example Atlas: mongodb+sandbox://username:password@cluster.mongodb.net/narss_dashboard
MONGO_URI=mongodb://127.0.0.1:27017/narss_dashboard

# JWT Secret Keys & Expirations
# Secrets should be strong, random strings in production
JWT_SECRET=super_secret_jwt_key_narss_2026_change_in_production
JWT_EXPIRE=1d

# Refresh Token Secret Keys & Expirations
JWT_REFRESH_SECRET=super_secret_refresh_token_key_narss_2026_change_in_production
JWT_REFRESH_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH=uploads/
